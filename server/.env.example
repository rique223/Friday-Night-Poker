# Copy to `server/.env` and fill in. Only JWT_SECRET is required.

# Signs the session cookie. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Port the API listens on.
PORT=4000

# development | production
# In production the server also serves the built client from client/dist.
NODE_ENV=development

# Set to true to expose DELETE /api/dev/reset, which DROPS ALL SESSIONS AND PLAYERS.
# Ignored entirely when NODE_ENV=production. Leave unset unless you mean it.
ENABLE_DEV_ROUTES=false

# Number of reverse proxies in front of the app, for correct client IPs in rate limiting.
# Leave at 0 when running the server directly (the default).
TRUST_PROXY=0
